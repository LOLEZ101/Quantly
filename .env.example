# Copy to .env for local development. Do not commit secrets.

DATABASE_URL=postgres://peer:peer@localhost:5432/peer_engine

# Required for live SEC EDGAR requests (not needed for --offline)
SEC_USER_AGENT=PeerEngine/0.3 (research; contact@example.com)
SEC_CONTACT_EMAIL=contact@example.com

RAW_DATA_DIR=data/raw
SNAPSHOT_OUTPUT_DIR=exports/snapshots
INGESTION_CONCURRENCY=2
INGESTION_DELAY_MS=200
REQUEST_TIMEOUT_MS=30000
MAX_RETRIES=3

# Optional live tests
RUN_LIVE_SEC_TESTS=false
RUN_DB_TESTS=false
