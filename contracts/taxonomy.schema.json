{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://peer-engine.local/contracts/taxonomy.schema.json",
  "title": "TaxonomyResponse",
  "description": "Taxonomy root or children-of-node API responses.",
  "oneOf": [
    { "$ref": "#/$defs/TaxonomyTreeResponse" },
    { "$ref": "#/$defs/TaxonomyChildrenResponse" },
    { "$ref": "#/$defs/TaxonomyNodeResponse" }
  ],
  "$defs": {
    "NodeType": {
      "type": "string",
      "enum": [
        "root",
        "sector",
        "industry_group",
        "industry",
        "sub_industry",
        "peer_cluster",
        "stub"
      ]
    },
    "TaxonomyNode": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "description",
        "node_type",
        "parent_id",
        "path",
        "depth",
        "inclusion_criteria",
        "exclusion_criteria",
        "allowed_child_node_types",
        "effective_date",
        "taxonomy_version",
        "is_leaf",
        "child_count"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$"
        },
        "name": { "type": "string", "minLength": 1 },
        "description": { "type": "string", "minLength": 1 },
        "node_type": { "$ref": "#/$defs/NodeType" },
        "parent_id": {
          "type": ["string", "null"],
          "pattern": "^[a-z][a-z0-9_]*$"
        },
        "path": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)*$"
        },
        "depth": { "type": "integer", "minimum": 0 },
        "inclusion_criteria": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "minItems": 1
        },
        "exclusion_criteria": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "allowed_child_node_types": {
          "type": "array",
          "items": { "$ref": "#/$defs/NodeType" },
          "uniqueItems": true
        },
        "effective_date": {
          "type": "string",
          "format": "date"
        },
        "taxonomy_version": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
        },
        "is_leaf": { "type": "boolean" },
        "child_count": { "type": "integer", "minimum": 0 }
      }
    },
    "TaxonomyTreeResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "response_type",
        "taxonomy_version",
        "as_of",
        "root"
      ],
      "properties": {
        "response_type": { "const": "taxonomy_tree" },
        "taxonomy_version": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
        },
        "as_of": { "type": "string", "format": "date" },
        "root": { "$ref": "#/$defs/TaxonomyNode" },
        "nodes": {
          "type": "array",
          "items": { "$ref": "#/$defs/TaxonomyNode" }
        }
      }
    },
    "TaxonomyChildrenResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "response_type",
        "taxonomy_version",
        "as_of",
        "parent",
        "children"
      ],
      "properties": {
        "response_type": { "const": "taxonomy_children" },
        "taxonomy_version": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
        },
        "as_of": { "type": "string", "format": "date" },
        "parent": { "$ref": "#/$defs/TaxonomyNode" },
        "children": {
          "type": "array",
          "items": { "$ref": "#/$defs/TaxonomyNode" }
        }
      }
    },
    "TaxonomyNodeResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "response_type",
        "taxonomy_version",
        "as_of",
        "node"
      ],
      "properties": {
        "response_type": { "const": "taxonomy_node" },
        "taxonomy_version": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
        },
        "as_of": { "type": "string", "format": "date" },
        "node": { "$ref": "#/$defs/TaxonomyNode" },
        "ancestors": {
          "type": "array",
          "items": { "$ref": "#/$defs/TaxonomyNode" }
        }
      }
    }
  }
}
