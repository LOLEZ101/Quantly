{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://peer-engine.local/contracts/snapshot-manifest.schema.json",
  "title": "SnapshotManifest",
  "description": "Immutable export manifest describing taxonomy, peer model, and artifact versions.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "response_type",
    "snapshot_id",
    "taxonomy_version",
    "peer_model_version",
    "adjacency_version",
    "created_at",
    "is_immutable",
    "artifacts",
    "counts"
  ],
  "properties": {
    "response_type": { "const": "snapshot_manifest" },
    "snapshot_id": {
      "type": "string",
      "pattern": "^snap_[a-z0-9][a-z0-9_-]*$"
    },
    "taxonomy_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "peer_model_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "adjacency_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "contract_versions": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "created_at": { "type": "string", "format": "date-time" },
    "published_at": { "type": ["string", "null"], "format": "date-time" },
    "as_of": { "type": ["string", "null"], "format": "date" },
    "is_immutable": { "const": true },
    "content_hash": {
      "type": ["string", "null"],
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "counts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "companies",
        "taxonomy_nodes",
        "primary_classifications",
        "peer_relationships"
      ],
      "properties": {
        "companies": { "type": "integer", "minimum": 0 },
        "taxonomy_nodes": { "type": "integer", "minimum": 0 },
        "primary_classifications": { "type": "integer", "minimum": 0 },
        "peer_relationships": { "type": "integer", "minimum": 0 },
        "evidence_records": { "type": "integer", "minimum": 0 }
      }
    },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "uri", "media_type"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "uri": { "type": "string", "minLength": 1 },
          "media_type": { "type": "string", "minLength": 1 },
          "content_hash": {
            "type": ["string", "null"],
            "pattern": "^sha256:[a-f0-9]{64}$"
          },
          "byte_size": {
            "type": ["integer", "null"],
            "minimum": 0
          }
        }
      }
    },
    "pilot_universe": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "telecommunications",
          "restaurants",
          "semiconductors_and_equipment"
        ]
      },
      "uniqueItems": true
    },
    "notes": { "type": ["string", "null"] }
  }
}
