{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://peer-engine.local/contracts/company-profile.schema.json",
  "title": "CompanyProfileResponse",
  "description": "Company identity, securities, index membership, and facet exposures.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "response_type",
    "company",
    "securities",
    "index_membership",
    "taxonomy_version",
    "as_of"
  ],
  "properties": {
    "response_type": { "const": "company_profile" },
    "taxonomy_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "as_of": { "type": "string", "format": "date" },
    "snapshot_id": { "type": ["string", "null"] },
    "company": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "company_key",
        "legal_name",
        "display_name",
        "is_active"
      ],
      "properties": {
        "company_key": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9_-]*$"
        },
        "legal_name": { "type": "string", "minLength": 1 },
        "display_name": { "type": "string", "minLength": 1 },
        "cik": { "type": ["string", "null"] },
        "lei": { "type": ["string", "null"] },
        "country_of_domicile": {
          "type": ["string", "null"],
          "pattern": "^[A-Z]{2}$"
        },
        "description": { "type": ["string", "null"] },
        "website": { "type": ["string", "null"], "format": "uri" },
        "is_active": { "type": "boolean" }
      }
    },
    "securities": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["ticker", "currency", "security_type", "is_primary"],
        "properties": {
          "ticker": { "type": "string", "minLength": 1 },
          "exchange": { "type": ["string", "null"] },
          "currency": { "type": "string", "pattern": "^[A-Z]{3}$" },
          "security_type": { "type": "string", "minLength": 1 },
          "isin": { "type": ["string", "null"] },
          "cusip": { "type": ["string", "null"] },
          "is_primary": { "type": "boolean" }
        }
      }
    },
    "index_membership": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["index_code", "index_name", "effective_from"],
        "properties": {
          "index_code": { "type": "string", "minLength": 1 },
          "index_name": { "type": "string", "minLength": 1 },
          "effective_from": { "type": "string", "format": "date" },
          "effective_to": { "type": ["string", "null"], "format": "date" }
        }
      }
    },
    "business_segments": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "segment_key",
          "segment_name",
          "revenue_weight",
          "confidence"
        ],
        "properties": {
          "segment_key": { "type": "string", "minLength": 1 },
          "segment_name": { "type": "string", "minLength": 1 },
          "node_id": {
            "type": ["string", "null"],
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "revenue_weight": { "type": "number", "minimum": 0, "maximum": 1 },
          "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
          "is_manual": { "type": "boolean" },
          "fiscal_year": { "type": ["integer", "null"] }
        }
      }
    },
    "customer_exposures": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["customer_type", "weight", "confidence"],
        "properties": {
          "customer_type": { "type": "string", "minLength": 1 },
          "weight": { "type": "number", "minimum": 0, "maximum": 1 },
          "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
          "is_manual": { "type": "boolean" }
        }
      }
    },
    "geographic_exposures": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["geo_code", "geo_name", "weight", "confidence"],
        "properties": {
          "geo_code": { "type": "string", "minLength": 1 },
          "geo_name": { "type": "string", "minLength": 1 },
          "weight": { "type": "number", "minimum": 0, "maximum": 1 },
          "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
          "is_manual": { "type": "boolean" }
        }
      }
    },
    "revenue_models": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["model_code", "model_name", "weight", "confidence"],
        "properties": {
          "model_code": { "type": "string", "minLength": 1 },
          "model_name": { "type": "string", "minLength": 1 },
          "weight": { "type": "number", "minimum": 0, "maximum": 1 },
          "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
          "is_manual": { "type": "boolean" }
        }
      }
    },
    "infrastructure_models": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["model_code", "model_name", "weight", "confidence"],
        "properties": {
          "model_code": { "type": "string", "minLength": 1 },
          "model_name": { "type": "string", "minLength": 1 },
          "weight": { "type": "number", "minimum": 0, "maximum": 1 },
          "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
          "is_manual": { "type": "boolean" },
          "notes": { "type": ["string", "null"] }
        }
      }
    },
    "financial_snapshot": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["as_of_date", "currency"],
      "properties": {
        "as_of_date": { "type": "string", "format": "date" },
        "currency": { "type": "string", "pattern": "^[A-Z]{3}$" },
        "market_cap": { "type": ["number", "null"] },
        "enterprise_value": { "type": ["number", "null"] },
        "revenue_ttm": { "type": ["number", "null"] },
        "revenue_growth_yoy": { "type": ["number", "null"] },
        "gross_margin": { "type": ["number", "null"] },
        "operating_margin": { "type": ["number", "null"] },
        "ebitda_margin": { "type": ["number", "null"] },
        "source": { "type": ["string", "null"] }
      }
    }
  }
}
