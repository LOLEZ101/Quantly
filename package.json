{
  "name": "peer-engine",
  "private": true,
  "version": "4.0.0",
  "type": "module",
  "description": "Quantly Peer Engine — classification, peers, provenance, and read-only snapshot API",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:live-sec": "RUN_LIVE_SEC_TESTS=true vitest run tests/phase3/live-sec.test.ts",
    "test:db": "RUN_DB_TESTS=true vitest run tests/phase3/database.integration.test.ts",
    "fixtures:generate": "tsx scripts/generate-pilot-fixtures.ts",
    "fixtures:sec": "tsx scripts/generate-sec-fixtures.ts",
    "fixtures:verified": "tsx scripts/generate-verified-sec-fixtures.ts",
    "phase3.5:verified": "tsx src/cli/phase3.ts phase3.5:verified --offline",
    "phase3.6:acceptance": "tsx src/cli/phase3.ts phase3.6:acceptance --offline",
    "phase3.7:operational": "tsx src/cli/phase3.ts phase3.7:operational --repository postgres --live-edgar --acceptance-set",
    "phase3.7:full": "tsx src/cli/phase3.ts phase3.7:operational --repository postgres --live-edgar --full-pilot",
    "phase3.7:memory": "tsx src/cli/phase3.ts phase3.7:operational --repository memory --offline --acceptance-set",
    "api:readonly": "tsx src/cli/api.ts",
    "validate": "tsx src/cli/phase2.ts validate",
    "classify:pilot": "tsx src/cli/phase2.ts classify",
    "peers:pilot": "tsx src/cli/phase2.ts peers",
    "review:pilot": "tsx src/cli/phase2.ts review",
    "snapshot:pilot": "tsx src/cli/phase2.ts snapshot",
    "phase2:pilot": "tsx src/cli/phase2.ts phase2",
    "db:up": "docker compose up -d postgres",
    "db:down": "docker compose down",
    "db:migrate": "tsx src/cli/phase3.ts db:migrate",
    "db:status": "tsx src/cli/phase3.ts db:status",
    "db:seed:pilot": "tsx src/cli/phase3.ts cache:seed",
    "identifiers:pilot": "tsx src/cli/phase3.ts identifiers:pilot --offline",
    "ingest:pilot": "tsx src/cli/phase3.ts ingest:pilot --offline",
    "normalize:pilot": "tsx src/cli/phase3.ts normalize:pilot --offline",
    "extract:evidence:pilot": "tsx src/cli/phase3.ts extract:evidence:pilot --offline",
    "reconcile:pilot": "tsx src/cli/phase3.ts reconcile:pilot --offline",
    "classify:sourced-pilot": "tsx src/cli/phase3.ts classify:sourced-pilot --offline",
    "peers:sourced-pilot": "tsx src/cli/phase3.ts peers:sourced-pilot --offline",
    "review:sourced-pilot": "tsx src/cli/phase3.ts review:sourced-pilot --offline",
    "snapshot:sourced-pilot": "tsx src/cli/phase3.ts snapshot:sourced-pilot --offline",
    "phase3:pilot": "tsx src/cli/phase3.ts phase3:pilot --offline",
    "ingest:company": "tsx src/cli/phase3.ts ingest:company --offline",
    "reconcile:company": "tsx src/cli/phase3.ts reconcile:company --offline",
    "classify:company": "tsx src/cli/phase3.ts classify:company --offline"
  },
  "dependencies": {
    "chart.js": "^4.4.8",
    "dotenv": "^17.2.1",
    "pg": "^8.16.3",
    "yahoo-finance2": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "@types/pg": "^8.15.5",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2",
    "vite": "^6.2.0",
    "vitest": "^4.1.10",
    "yaml": "^2.9.0"
  }
}
